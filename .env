# Begin Masimba FarmOS Environment Configuration

# Database Settings
DATABASE_URL=mysql:host=localhost;port=3306;dbname=begin_masimba_farm;charset=utf8mb4
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=begin_masimba_farm
DB_USER=root
DB_PASSWORD=

# API Configuration
API_KEY=local-dev-key
JWT_SECRET=change-me-in-production-min-32-chars
SECRET_KEY=change-me-in-production-min-32-chars
JWT_EXPIRATION_SECONDS=3600

# Application Settings
APP_URL=http://localhost:8081
NODE_ENV=development

# CORS Settings
CORS_ORIGIN=http://localhost:8081

# Multi-tenancy
TENANT_ID=1

# Logging
LOG_LEVEL=INFO
